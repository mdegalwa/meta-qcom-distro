 	NULL
 };
 
@@ -1062,6 +1064,7 @@
 {
 	struct rte_kvargs *kvlist;
 	uint16_t sdp3_no_tx_disable;
+	uint16_t non_coherent;
 
 	if (devargs == NULL)
 		return;
@@ -1076,6 +1079,16 @@
 	    sdp3_no_tx_disable == 1)
 		adapter->sdp3_no_tx_disable = 1;
 
+	if (rte_kvargs_count(kvlist, IXGBE_DEVARG_NON_COHERENT) == 1 &&
